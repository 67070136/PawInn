# Copy to .env for your LOCAL college demo. Never commit real credentials.
# One PostgreSQL instance hosts three fixed databases defined in database/init.sql.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=pawinn
POSTGRES_PASSWORD=replace-with-a-local-demo-password

# Backend owners read POSTGRES_* and select their own database:
# account -> pawinn_account, room -> pawinn_room, booking -> pawinn_booking.
# Future Compose API containers use POSTGRES_HOST=postgres and POSTGRES_PORT=5432.
# These backend/auth settings are for implementation; services are still scaffolds.
ACCOUNT_PORT=3001
ROOM_PORT=3002
BOOKING_PORT=3003
JWT_SECRET=replace-with-a-local-demo-signing-secret
ACCOUNT_URL=http://account:3001
ROOM_URL=http://room:3002
