# Local course-demo samples. Copy to .env when implementing Compose.
# Member 3 owns this template; each owner documents any additions.
# The backend services and Compose file do not read these settings yet.
POSTGRES_USER=pawinn
POSTGRES_PASSWORD=replace-with-a-local-demo-password
POSTGRES_ACCOUNT_DB=pawinn_account
POSTGRES_ROOM_DB=pawinn_room
POSTGRES_BOOKING_DB=pawinn_booking

# Compose supplies a separate DATABASE_URL to each service using the values above.
# Keep connection strings out of source files and out of the frontend bundle.
ACCOUNT_PORT=3001
ROOM_PORT=3002
BOOKING_PORT=3003
JWT_SECRET=replace-with-a-local-demo-signing-secret
ACCOUNT_URL=http://account:3001
ROOM_URL=http://room:3002
